DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# postgres (default) or sqlite (zero-setup local file db.sqlite3)
DB_ENGINE=postgres
POSTGRES_DB=fdc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional: path to a local clone of github.com/statsbomb/open-data (the repo root)
STATSBOMB_OPEN_DATA_DIR=

# Catapult OpenField Connect API (read-only token, "Summary Data" scope is enough)
OPENFIELD_API_TOKEN=
OPENFIELD_REGION=eu
